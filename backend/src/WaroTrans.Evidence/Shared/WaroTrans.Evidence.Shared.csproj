<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Evidence-owned model shared by the Recorder (API, migration owner) and the Worker (restricted writer).
    Holds entities, the DbContext mapping, wire contracts and the S3 key schema. No migrations here: only the Recorder
    owns them (docs/adr/0012). Never references the modular monolith.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WaroTrans.Evidence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.400" />
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400" />
  </ItemGroup>

</Project>
