<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Evidence Recorder: the Evidence API and the only owner of the Evidence migrations (docs/adr/0012).
    A separate process from WaroTrans.Host; it shares only BuildingBlocks (token validation, permissions).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WaroTrans.Evidence.Recorder</RootNamespace>
    <UserSecretsId>warotrans-evidence-recorder</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\WaroTrans.Evidence.Shared.csproj" />
    <ProjectReference Include="..\..\WaroTrans.BuildingBlocks\WaroTrans.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AWSSDK.CloudFront" Version="3.7.400" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.400" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WaroTrans.Evidence.UnitTests" />
    <InternalsVisibleTo Include="WaroTrans.Evidence.IntegrationTests" />
  </ItemGroup>

</Project>
