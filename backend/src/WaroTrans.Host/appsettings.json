{
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5433;Database=warotrans;Username=warotrans;Password=warotrans",
    "MongoDB": "mongodb://warotrans:warotrans@localhost:27018/?authSource=admin"
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5433;Database=warotrans;Username=warotrans;Password=warotrans"
  },
  "Mongo": {
    "ConnectionString": "mongodb://warotrans:warotrans@localhost:27018/?authSource=admin",
    "DatabaseName": "warotrans_operations"
  },
  "Mqtt": {
    "Host": "127.0.0.1",
    "Port": 1883,
    "ConnectTimeoutSeconds": 5,
    "ClientId": "warotrans-host",
    "TopicPrefix": "warotrans/v1",
    "HeartbeatTimeoutSeconds": 5,
    "CommandAckTimeoutSeconds": 10
  },
  "StalledWork": {
    "UnstartedJobMinutes": 10,
    "HumanStepMinutes": 15,
    "CheckIntervalSeconds": 60
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "warotrans",
      "Audience": "warotrans-clients",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "MapAssetStorage": {
    "Provider": "Local",
    "S3": {
      "BucketName": "warotrans-ob-storage",
      "Region": "ap-southeast-1",
      "KeyPrefix": "maps",
      "PublicBaseUrl": "",
      "AccessKeyId": "",
      "SecretAccessKey": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
