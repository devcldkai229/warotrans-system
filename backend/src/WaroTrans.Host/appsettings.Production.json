{
  "//": "AWS demo (ECS). No secrets here: connection strings, Jwt:Key, EvidenceBridge:ServiceToken and the IoT certificate come from Secrets Manager as environment variables of the task. Same traffic behaviour as the RealRobot launch profile the two robots were tested with.",
  "EvidenceBridge": {
    "Enabled": true
  },
  "Mqtt": {
    "Port": 8883,
    "UseTls": true,
    "ClientIdIncludesProcessId": false,
    "ClientId": "warotrans-host",
    "TopicPrefix": "warotrans/v1"
  },
  "RobotCamera": {
    "Robots": {}
  },
  "MapAssetStorage": {
    "Provider": "S3"
  },
  "ReverseProxy": {
    "TrustCloudFrontProto": true
  },
  "HumanTasks": {
    "StopWorkZonePrioritySeconds": 5,
    "StopBeginWindowSeconds": 30,
    "StopBeginReminderSeconds": 10,
    "StopUnstartedEscalationSeconds": 60,
    "StopWorkWindowSeconds": 60,
    "StopWorkExtensionSeconds": 30,
    "StopDisconnectSeconds": 15
  },
  "Traffic": {
    "Mode": "Semantic",
    "SemanticHorizonMeters": 2.0,
    "SemanticZoneMarginMeters": 0.05,
    "SemanticLaneHalfWidthMeters": 0.25,
    "SemanticPrefixGrant": true,
    "SemanticCellSizeMeters": 0.10,
    "SemanticPathToleranceMeters": 0.15,
    "RequireCoordinatorLease": true,
    "RobotHomeEndpoints": {
      "RBT-001": "EP-PARKING-A",
      "RBT-002": "EP-PARKING-B"
    }
  },
  "FleetIdle": {
    "AutoReturnToPark": false,
    "IdleSeconds": 3,
    "FallbackEndpointCodes": "EP-QUEUE-A,EP-QUEUE-B"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
