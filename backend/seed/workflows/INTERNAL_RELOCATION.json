{
  "code": "INTERNAL_RELOCATION",
  "name": "Internal Relocation",
  "description": "Move an identified Container between two valid internal storage locations.",
  "variables": [
    {
      "key": "assignedRobotId",
      "name": "assignedRobotId",
      "dataType": "UUID",
      "source": "SYSTEM_VALUE",
      "isRequired": true,
      "description": "Robot assigned to the current Job.",
      "sequenceNo": 0
    },
    {
      "key": "inspectionEndpointId",
      "name": "Inspection Endpoint",
      "dataType": "UUID",
      "source": "ADMIN_INPUT",
      "isRequired": true,
      "description": "EP-INSPECTION configured by Admin.",
      "sequenceNo": 1,
      "format": "WAYPOINT"
    },
    {
      "key": "checkQuality",
      "name": "Check Quality?",
      "dataType": "BOOLEAN",
      "source": "STAFF_INPUT",
      "isRequired": true,
      "description": "Confirm whether the robot must visit Quality Inspection before delivery.",
      "sequenceNo": 2
    }
  ],
  "tasks": [
    {
      "taskKey": "COLLECT_CONTAINERS",
      "name": "Collect Containers",
      "sequenceNo": 1,
      "steps": [
        {
          "stepKey": "MOVE_TO_PICKUP",
          "name": "Move to Pickup",
          "stepType": "MOVE",
          "sequenceNo": 1,
          "operationCode": "PICKUP",
          "inputBindings": {
            "purpose": {
              "sourceType": "CONSTANT",
              "constantValue": "PICKUP"
            },
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "targetEndpointId": {
              "sourceType": "CURRENT_MOVEMENT",
              "sourceReference": "source.endpointId"
            },
            "commandTimeoutSeconds": {
              "sourceType": "CONSTANT",
              "constantValue": 360
            }
          },
          "timeoutSeconds": 360,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR"
        },
        {
          "stepKey": "CONFIRM_PICKUP",
          "name": "Confirm Pickup",
          "stepType": "HUMAN_INTERACTION",
          "sequenceNo": 2,
          "operationCode": "PICKUP_CONFIRM",
          "instructionText": "Take the Container off its current shelf and put it on the robot.",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "endpointId": {
              "sourceType": "CURRENT_MOVEMENT",
              "sourceReference": "source.endpointId"
            },
            "containerId": {
              "sourceType": "CURRENT_MOVEMENT",
              "sourceReference": "containerId"
            }
          },
          "timeoutSeconds": 300,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR"
        }
      ]
    },
    {
      "taskKey": "QUALITY_INSPECTION",
      "name": "Quality Inspection",
      "sequenceNo": 2,
      "runCondition": {
        "variableKey": "checkQuality",
        "equals": true
      },
      "steps": [
        {
          "stepKey": "MOVE_TO_INSPECTION",
          "name": "Move to Inspection",
          "stepType": "MOVE",
          "sequenceNo": 1,
          "operationCode": "TRANSIT",
          "inputBindings": {
            "purpose": {
              "sourceType": "CONSTANT",
              "constantValue": "TRANSIT"
            },
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "targetEndpointId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "inspectionEndpointId"
            },
            "commandTimeoutSeconds": {
              "sourceType": "CONSTANT",
              "constantValue": 360
            }
          },
          "timeoutSeconds": 360,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR"
        },
        {
          "stepKey": "CONFIRM_QUALITY_INSPECTION",
          "name": "Confirm Quality Inspection",
          "stepType": "HUMAN_INTERACTION",
          "sequenceNo": 2,
          "operationCode": "INSPECTION_CONFIRM",
          "instructionText": "Inspect outbound containers at EP-INSPECTION and confirm.",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "endpointId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "inspectionEndpointId"
            }
          },
          "timeoutSeconds": 300,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR"
        }
      ]
    },
    {
      "taskKey": "DELIVER_CONTAINERS",
      "name": "Deliver Containers",
      "sequenceNo": 3,
      "steps": [
        {
          "stepKey": "MOVE_TO_DROPOFF",
          "name": "Move to Dropoff",
          "stepType": "MOVE",
          "sequenceNo": 1,
          "operationCode": "DROPOFF",
          "inputBindings": {
            "purpose": {
              "sourceType": "CONSTANT",
              "constantValue": "DROPOFF"
            },
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "targetEndpointId": {
              "sourceType": "CURRENT_MOVEMENT",
              "sourceReference": "destination.endpointId"
            },
            "commandTimeoutSeconds": {
              "sourceType": "CONSTANT",
              "constantValue": 360
            }
          },
          "timeoutSeconds": 360,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR"
        },
        {
          "stepKey": "CONFIRM_DROPOFF",
          "name": "Confirm Dropoff",
          "stepType": "HUMAN_INTERACTION",
          "sequenceNo": 2,
          "operationCode": "DROPOFF_CONFIRM",
          "instructionText": "Take the Container off the robot and place it on the new shelf.",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "endpointId": {
              "sourceType": "CURRENT_MOVEMENT",
              "sourceReference": "destination.endpointId"
            },
            "containerId": {
              "sourceType": "CURRENT_MOVEMENT",
              "sourceReference": "containerId"
            }
          },
          "timeoutSeconds": 300,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR"
        }
      ]
    }
  ]
}
