{
    "summary":  "API test INTERNAL_RELOCATION (Vận chuyển giữa các kệ)",
    "endpoints":  {
                      "create":  "POST /api/workflow-execution/workflows",
                      "get":  "GET /api/workflow-execution/workflows/{id}",
                      "publish":  "POST /api/workflow-execution/workflows/{id}/publish",
                      "metadata":  "GET /api/workflow-execution/metadata/step-types"
