                  "publishResponse":  "INTERNAL_RELOCATION.publish.response.json",
                  "metadata":  "workflow-metadata.step-types.json"
              },
    "inputMeaning":  {
                         "ADMIN_INPUT":  "minBatteryPercent=25 — Admin nhập lúc tạo template; lưu trong variablesSchema.configuredValue; runtime chỉ đọc lại.",
                         "STAFF_INPUT":  "containerId, sourceEndpointId, destinationEndpointId — template chỉ lưu metadata; Staff nhập khi tạo TransportRequest (chưa có UI trong round này).",
                         "SYSTEM_VALUE":  "assignedRobotId, transportRequestId, jobId — runtime resolve qua SystemVariableResolver; không nhập tay.",
                         "bindings":  "Mỗi step input bind từ WORKFLOW_VAR / CONSTANT / CURRENT_MOVEMENT / STEP_OUTPUT — không hard-code trong executor."
                     },
    "processing":  {
                       "draftCreate":  "ValidateDraft (structural): unique keys, required fields. Status=DRAFT. Persisted: workflows + workflow_tasks + workflow_steps; variablesSchema JSONB; input_bindings JSONB; config JSONB (operationCode).",
                       "publish":  "ValidateForPublish (full registry): mỗi required input phải có binding đúng type; SYSTEM_VALUE key phải nằm catalog; CONSTANT phải đúng allowedValues. Status=PUBLISHED + publishedAt.",
                       "runtimeNotYetWired":  "Job Planning chưa có. Khi chạy Job: VariableContextBuilder (ADMIN+STAFF+SYSTEM) -\u003e StepInputResolver -\u003e JobStep.ResolvedInputs -\u003e executor -\u003e JobStep.OutputValues. Template KHÔNG lưu runtime result."
                   },
    "storageShape":  {
                         "table_workflows":  "code, version_no, name, status, variables_schema (jsonb), created_by, created_at, published_at",
                         "table_workflow_tasks":  "workflow_id, task_key, name, sequence_no",
                         "table_workflow_steps":  "workflow_task_id, step_key, name, step_type, sequence_no, config (jsonb: operationCode), input_bindings (jsonb), timeout/maxAttempts/onFailure"
