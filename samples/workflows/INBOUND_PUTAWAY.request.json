{
  "code": "INBOUND_PUTAWAY",
  "name": "Inbound put-away",
  "description": "The robot collects received containers at the inbound dock, staff confirm each container is loaded, the robot carries them to their storage racks and staff confirm each put-away. Movement fields bind through CURRENT_MOVEMENT (source = inbound dock, destination = rack).",
  "variables": [
    {
      "key": "minBatteryPercent",
      "name": "Minimum battery (%)",
      "dataType": "DECIMAL",
      "source": "ADMIN_INPUT",
      "isRequired": true,
      "configuredValue": 25,
      "description": "Configured by the admin when the template is created. The runtime only reads this value.",
      "sequenceNo": 0
    },
    {
      "key": "assignedRobotId",
      "name": "Assigned robot",
      "dataType": "UUID",
      "source": "SYSTEM_VALUE",
      "isRequired": true,
      "description": "Resolved at runtime from the job assignment. Not entered by admin or staff.",
      "sequenceNo": 1
    },
    {
      "key": "transportRequestId",
      "name": "TransportRequest",
      "dataType": "UUID",
      "source": "SYSTEM_VALUE",
      "isRequired": true,
      "description": "Id of the running transport request.",
      "sequenceNo": 2
    },
    {
      "key": "jobId",
      "name": "Job",
      "dataType": "UUID",
      "source": "SYSTEM_VALUE",
      "isRequired": true,
      "description": "Id of the runtime job created from this template.",
      "sequenceNo": 3
    }
  ],
  "tasks": [
    {
      "taskKey": "RECEIVE",
      "name": "Receive at inbound dock",
      "sequenceNo": 1,
      "steps": [
        {
          "stepKey": "CHECK_ROBOT_READY",
          "name": "Check robot is ready",
          "stepType": "CHECK",
          "sequenceNo": 1,
          "operationCode": "ROBOT_READY",
          "timeoutSeconds": 30,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR",
          "inputBindings": {
            "robotId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "assignedRobotId" }
          }
        },
        {
          "stepKey": "CHECK_BATTERY",
          "name": "Check minimum battery",
          "stepType": "CHECK",
          "sequenceNo": 2,
          "operationCode": "BATTERY_MIN",
          "timeoutSeconds": 30,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "REQUEST_REASSIGN",
          "inputBindings": {
            "robotId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "assignedRobotId" },
            "minimumBatteryPercent": { "sourceType": "WORKFLOW_VAR", "sourceReference": "minBatteryPercent" }
          }
        },
        {
          "stepKey": "CHECK_REQUEST_ACTIVE",
          "name": "Check request is still active",
          "stepType": "CHECK",
          "sequenceNo": 3,
          "operationCode": "REQUEST_ACTIVE",
          "timeoutSeconds": 30,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "FAIL_JOB",
          "inputBindings": {
            "transportRequestId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "transportRequestId" }
          }
        },
        {
          "stepKey": "CHECK_DOCK_AVAILABLE",
          "name": "Check inbound dock is available",
          "stepType": "CHECK",
          "sequenceNo": 4,
          "operationCode": "ENDPOINT_AVAILABLE",
          "timeoutSeconds": 30,
          "maxAttempts": 2,
          "retryBackoffSeconds": 5,
          "onFailure": "PAUSE_FOR_OPERATOR",
          "inputBindings": {
            "endpointId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "source.endpointId" }
          }
        },
        {
          "stepKey": "MOVE_TO_DOCK",
          "name": "Move to inbound dock",
          "stepType": "MOVE",
          "sequenceNo": 5,
          "operationCode": "PICKUP",
          "timeoutSeconds": 600,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "REQUEST_REASSIGN",
          "inputBindings": {
            "robotId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "assignedRobotId" },
            "targetEndpointId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "source.endpointId" },
            "purpose": { "sourceType": "CONSTANT", "constantValue": "PICKUP" }
          }
        },
        {
          "stepKey": "RECEIVE_CONFIRM",
          "name": "Staff confirm received container loaded onto robot",
          "stepType": "HUMAN_INTERACTION",
          "sequenceNo": 6,
          "operationCode": "PICKUP_CONFIRM",
          "instructionText": "Scan the received container at the inbound dock, place it on the robot, then confirm.",
          "timeoutSeconds": 900,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR",
          "inputBindings": {
            "robotId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "assignedRobotId" },
            "containerId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "containerId" },
            "endpointId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "source.endpointId" }
          }
        }
      ]
    },
    {
      "taskKey": "PUTAWAY",
      "name": "Put away on storage rack",
      "sequenceNo": 2,
      "steps": [
        {
          "stepKey": "CHECK_RACK_AVAILABLE",
          "name": "Check storage rack is available",
          "stepType": "CHECK",
          "sequenceNo": 1,
          "operationCode": "ENDPOINT_AVAILABLE",
          "timeoutSeconds": 30,
          "maxAttempts": 2,
          "retryBackoffSeconds": 5,
          "onFailure": "PAUSE_FOR_OPERATOR",
          "inputBindings": {
            "endpointId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "destination.endpointId" }
          }
        },
        {
          "stepKey": "MOVE_TO_RACK",
          "name": "Move to storage rack",
          "stepType": "MOVE",
          "sequenceNo": 2,
          "operationCode": "DROPOFF",
          "timeoutSeconds": 600,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "REQUEST_REASSIGN",
          "inputBindings": {
            "robotId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "assignedRobotId" },
            "targetEndpointId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "destination.endpointId" },
            "purpose": { "sourceType": "CONSTANT", "constantValue": "DROPOFF" }
          }
        },
        {
          "stepKey": "PUTAWAY_CONFIRM",
          "name": "Staff confirm container stored on rack",
          "stepType": "HUMAN_INTERACTION",
          "sequenceNo": 3,
          "operationCode": "DROPOFF_CONFIRM",
          "instructionText": "Take the container off the robot, store it on the rack, then confirm.",
          "timeoutSeconds": 900,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR",
          "inputBindings": {
            "robotId": { "sourceType": "WORKFLOW_VAR", "sourceReference": "assignedRobotId" },
            "containerId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "containerId" },
            "endpointId": { "sourceType": "CURRENT_MOVEMENT", "sourceReference": "destination.endpointId" }
          }
        }
      ]
    }
  ]
}
