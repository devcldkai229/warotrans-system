{
  "code": "ROBOT_CHARGING",
  "name": "Robot charging",
  "description": "The robot drives to a charger and a person connects it. There is no auto-dock.",
  "variables": [
    {
      "key": "chargerEndpointId",
      "name": "Charger",
      "dataType": "UUID",
      "source": "STAFF_INPUT",
      "isRequired": true,
      "description": "Chosen when the Job is made.",
      "sequenceNo": 0
    },
    {
      "key": "assignedRobotId",
      "name": "Assigned robot",
      "dataType": "UUID",
      "source": "SYSTEM_VALUE",
      "isRequired": true,
      "description": "Resolved at runtime from the job assignment.",
      "sequenceNo": 1
    }
  ],
  "tasks": [
    {
      "taskKey": "CHARGE",
      "name": "Go to the charger",
      "sequenceNo": 1,
      "steps": [
        {
          "stepKey": "CHECK_READY",
          "name": "Check robot is ready",
          "stepType": "CHECK",
          "sequenceNo": 1,
          "operationCode": "ROBOT_READY",
          "timeoutSeconds": 30,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "FAIL_JOB",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            }
          }
        },
        {
          "stepKey": "CHECK_EMPTY",
          "name": "Check nothing is on board",
          "stepType": "CHECK",
          "sequenceNo": 2,
          "operationCode": "LOAD_STATE",
          "timeoutSeconds": 30,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "FAIL_JOB",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "expectedLoadState": {
              "sourceType": "CONSTANT",
              "constantValue": "EMPTY"
            }
          }
        },
        {
          "stepKey": "MOVE_CHARGER",
          "name": "Drive to the charger",
          "stepType": "MOVE",
          "sequenceNo": 3,
          "operationCode": "CHARGE",
          "timeoutSeconds": 600,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "FAIL_JOB",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "targetEndpointId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "chargerEndpointId"
            },
            "purpose": {
              "sourceType": "CONSTANT",
              "constantValue": "CHARGE"
            }
          }
        },
        {
          "stepKey": "CONNECT_CONFIRM",
          "name": "A person connects the charger",
          "stepType": "HUMAN_INTERACTION",
          "sequenceNo": 4,
          "operationCode": "CHARGE_CONNECT_CONFIRM",
          "timeoutSeconds": 900,
          "maxAttempts": 1,
          "retryBackoffSeconds": 0,
          "onFailure": "PAUSE_FOR_OPERATOR",
          "inputBindings": {
            "robotId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "assignedRobotId"
            },
            "chargerEndpointId": {
              "sourceType": "WORKFLOW_VAR",
              "sourceReference": "chargerEndpointId"
            }
          }
        }
      ]
    }
  ]
}
