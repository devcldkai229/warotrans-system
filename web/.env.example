# Leave empty in local Vite so /api goes through the dev proxy (same-origin refresh cookie).
# Set an absolute URL only when the SPA is not served behind that proxy.
# VITE_API_URL=http://localhost:5090
# Skip the login screen while the UI still runs on mock data (set in .env.local, never commit)
# VITE_MOCK_AUTO_LOGIN=true
# Dev-only Fleet Map alignment overlay (PARK vs PoseX/Y + worldToPixel). Never enable in prod builds.
# VITE_MAP_ALIGN_DEBUG=true

